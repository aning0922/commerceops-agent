          },
          "requires_confirmation": {
            "const": true,
            "default": true,
            "title": "Requires Confirmation",
            "type": "boolean"
          },
          "execution_available": {
            "const": false,
            "default": false,
            "title": "Execution Available",
            "type": "boolean"
          }
        },
        "required": [
