            "title": "Status",
            "type": "string"
          },
          "reason": {
            "enum": [
              "EXPLICIT_PARAMETERS",
              "MISSING_PARAMETERS",
              "INVALID_PARAMETERS",
              "UNSUPPORTED_TEXT"
            ],
            "title": "Reason",
            "type": "string"
          },
          "shop_id": {
            "format": "uuid",
            "title": "Shop Id",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/P5WooSource"
          },
          "window": {
            "$ref": "#/components/schemas/P5WooWindow"
          },
          "scope": {
            "$ref": "#/components/schemas/P5WooScope"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/P5Candidate"
