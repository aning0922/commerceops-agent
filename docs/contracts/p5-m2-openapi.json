          "plan_id",
          "task_id",
          "plan_version",
          "plan_hash",
          "hash_version",
          "status",
          "source",
          "currency",
          "rule_version",
          "parameters",
          "config_version",
          "expires_at",
          "items",
          "item_count",
          "total_units",
          "required_assumptions",
          "hard_blocks",
          "quality_flags",
          "disclosure_complete",
          "created_at"
