            "title": "Schema Version",
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "mock",
              "woocommerce_test"
            ],
            "title": "Source Kind",
            "type": "string"
          },
          "source_config_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Config Version"
