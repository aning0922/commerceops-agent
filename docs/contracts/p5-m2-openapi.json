{
  "openapi": "3.1.0",
  "info": {
    "title": "P5 M2 additions to P3 and P4 N01 contracts",
    "version": "p5-m2-v1"
  },
  "paths": {
    "/api/v1/tasks/preflight": {
      "post": {
        "operationId": "preflightNewCycle",
        "summary": "当前Web operator/shop自然语言参数草稿；明确确认前零业务写入",
        "responses": {
          "200": {
            "description": "只读业务preflight结果；ready仍需本地明确确认和独立显式提交",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/P5PreflightResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "所有成功和错误均no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Vary": {
                "description": "Cookie, Origin",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "请求无法解码或cursor/filter无效，无原输入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/N01Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "所有成功和错误均no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Vary": {
                "description": "Cookie, Origin",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "会话失效/缺失/撤权或统一登录失败，无对象信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/N01Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "所有成功和错误均no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Vary": {
                "description": "Cookie, Origin",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "无能力/CSRF/Origin拒绝，无对象信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/N01Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "所有成功和错误均no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Vary": {
                "description": "Cookie, Origin",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "不存在/不可见对象/非法对象ID一致",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/N01Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "所有成功和错误均no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Vary": {
                "description": "Cookie, Origin",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "415": {
            "description": "仅支持JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/N01Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "所有成功和错误均no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Vary": {
                "description": "Cookie, Origin",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "严格输入验证，无输入回显",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/N01Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "所有成功和错误均no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Vary": {
                "description": "Cookie, Origin",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "数据库/配置不可用，提交事实须按原键核实",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/N01Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "所有成功和错误均no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Vary": {
                "description": "Cookie, Origin",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "当前Woo来源配置不可用；不降级Mock，不读取秘密或创建任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/N01Error"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "所有成功和错误均no-store",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Vary": {
                "description": "Cookie, Origin",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri",
              "description": "精确配置scheme/host/port；missing/null/非允许Origin拒绝"
            }
          }
        ],
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "x-implementation-status": "not_implemented",
        "x-authority-contract": "p5-m2-v1.md",
        "x-cache-control": "no-store",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/N01PreflightInput"
                  },
                  {
                    "$ref": "#/components/schemas/P5WooPreflightInput"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "P5WooCreateParameters": {
        "additionalProperties": false,
        "properties": {
          "source_mode": {
            "const": "woocommerce_test",
            "title": "Source Mode",
            "type": "string"
          },
          "source_config_version": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Source Config Version",
            "type": "string"
          },
          "L": {
            "maximum": 365,
            "minimum": 0,
            "title": "L",
            "type": "integer"
          },
          "R": {
            "maximum": 365,
            "minimum": 0,
            "title": "R",
            "type": "integer"
          },
          "S": {
            "maximum": 365,
            "minimum": 0,
            "title": "S",
            "type": "integer"
          }
        },
        "required": [
          "source_mode",
          "source_config_version",
          "L",
          "R",
          "S"
        ],
        "title": "WooCreateParameters",
        "type": "object"
      },
      "P5WooPreflightInput": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "p3-web-v1",
            "title": "Schema Version",
            "type": "string"
          },
          "source_mode": {
            "const": "woocommerce_test",
            "title": "Source Mode",
            "type": "string"
          },
          "shop_id": {
            "format": "uuid",
            "title": "Shop Id",
            "type": "string"
          },
          "source_config_version": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Source Config Version",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "source_mode",
          "shop_id",
          "source_config_version",
          "text"
        ],
        "title": "WooPreflightInput",
        "type": "object"
      },
      "P5Candidate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "L",
              "R",
              "S"
            ],
            "title": "Name",
            "type": "string"
          },
          "value": {
            "maximum": 365,
            "minimum": 0,
            "title": "Value",
            "type": "integer"
          },
          "source": {
            "enum": [
              "explicit_text",
              "demo_assumption"
            ],
            "title": "Source",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End"
          }
        },
        "required": [
          "name",
          "value",
          "source"
        ],
        "title": "Candidate",
        "type": "object"
      },
      "P5WooScope": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "all_shop_products",
            "default": "all_shop_products",
            "title": "Kind",
            "type": "string"
          },
          "shop_id": {
            "format": "uuid",
            "title": "Shop Id",
            "type": "string"
          },
          "source": {
            "const": "selected_shop",
            "default": "selected_shop",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "shop_id"
        ],
        "title": "WooScope",
        "type": "object"
      },
      "P5WooSource": {
        "additionalProperties": false,
        "properties": {
          "source_mode": {
            "const": "woocommerce_test",
            "default": "woocommerce_test",
            "title": "Source Mode",
            "type": "string"
          },
          "source_config_version": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Source Config Version",
            "type": "string"
          },
          "evidence_mode": {
            "const": "not_used",
            "default": "not_used",
            "title": "Evidence Mode",
            "type": "string"
          }
        },
        "required": [
          "source_config_version"
        ],
        "title": "WooSource",
        "type": "object"
      },
      "P5WooWindow": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "last_seven_complete_days",
            "default": "last_seven_complete_days",
            "title": "Kind",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "source": {
            "const": "commerce_configuration",
            "default": "commerce_configuration",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "timezone",
          "as_of"
        ],
        "title": "WooWindow",
        "type": "object"
      },
      "P5WooPreflightResult": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "p5-n01-web-v1",
