{
  "$defs": {
    "CandidateResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "p6-copy-web-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedCandidate"
            },
            {
              "$ref": "#/$defs/RejectedCandidate"
            },
            {
              "$ref": "#/$defs/PendingCandidate"
            },
            {
              "$ref": "#/$defs/UnavailableCandidate"
            }
          ],
          "title": "Data"
        }
      },
      "required": [
        "schema_version",
        "data"
      ],
      "title": "CandidateResponse",
      "type": "object"
    },
    "Chunk": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/Document"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "chunk_version": {
          "title": "Chunk Version",
          "type": "string"
        },
        "chunker_version": {
          "title": "Chunker Version",
          "type": "string"
        },
        "section": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "document",
        "chunk_id",
        "chunk_version",
        "chunker_version",
        "section",
        "start",
        "end",
        "text",
        "text_sha256"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "product_title",
            "sop_excerpt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "product": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProductCitation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sop": {
          "anyOf": [
            {
              "$ref": "#/$defs/SopCitation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "maxLength": 2100,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Claim Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "claim_id"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CopyCandidate": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "p6-copy-candidate-v1",
          "default": "p6-copy-candidate-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_version": {
          "const": "v1",
          "default": "v1",
          "title": "Candidate Version",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "reviewer_id": {
          "format": "uuid",
          "title": "Reviewer Id",
          "type": "string"
        },
        "product_source_id": {
          "format": "uuid",
          "title": "Product Source Id",
          "type": "string"
        },
        "retrieval": {
          "$ref": "#/$defs/PgRetrieval"
        },
        "product": {
          "$ref": "#/$defs/ProductCitation"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 6,
          "minItems": 2,
          "title": "Claims",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "candidate_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Hash",
          "type": "string"
        },
        "narrative_mode": {
          "const": "template",
          "default": "template",
          "title": "Narrative Mode",
          "type": "string"
        },
        "model_evidence_mode": {
          "const": "not_used",
          "default": "not_used",
          "title": "Model Evidence Mode",
          "type": "string"
        },
        "publication_allowed": {
          "const": false,
          "default": false,
          "title": "Publication Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "owner_id",
        "reviewer_id",
        "product_source_id",
        "retrieval",
        "product",
        "as_of",
        "expires_at",
        "claims",
        "text",
        "candidate_hash"
      ],
      "title": "CopyCandidate",
      "type": "object"
    },
    "CopyError": {
      "additionalProperties": false,
      "description": "The copy paths emit the P3 error shape with no business-decision receipt.",
      "properties": {
        "schema_version": {
          "const": "p3-web-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "server_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Server Time"
        },
        "trace_id": {
          "format": "uuid",
          "title": "Trace Id",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/CopyErrorDetail"
        }
      },
      "required": [
        "schema_version",
        "server_time",
        "trace_id",
        "error"
      ],
      "title": "CopyError",
      "type": "object"
    },
    "CopyErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_CURSOR",
            "INVALID_FILTER",
            "INVALID_JSON",
            "SESSION_INVALID",
            "LOGIN_FAILED",
            "ACCESS_DENIED",
            "CSRF_INVALID",
            "ORIGIN_DENIED",
            "RESOURCE_NOT_FOUND",
            "PLAN_CHANGED",
            "APPROVAL_SUPERSEDED",
            "DECISION_CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "ITEM_STATE_CONFLICT",
            "ITEM_VERSION_CONFLICT",
            "ASSUMPTION_ACK_REQUIRED",
            "ASSUMPTION_SET_MISMATCH",
            "DATA_INCOMPLETE",
            "SCOPE_REQUIRED",
            "NOT_READY",
            "APPROVAL_EXPIRED",
            "UNSUPPORTED_MEDIA_TYPE",
            "INVALID_REQUEST",
            "RATE_LIMITED",
            "SERVICE_UNAVAILABLE"
          ],
          "title": "Code",
          "type": "string"
        },
        "safe_message": {
          "maxLength": 200,
          "title": "Safe Message",
          "type": "string"
        },
        "retryable": {
          "const": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "receipt": {
          "const": null,
          "title": "Receipt",
          "type": "null"
        }
      },
      "required": [
        "code",
        "safe_message",
        "retryable",
        "receipt"
      ],
      "title": "CopyErrorDetail",
      "type": "object"
    },
    "DecisionResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "p6-copy-web-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedDecision"
            },
            {
              "$ref": "#/$defs/RejectedDecision"
            }
          ],
          "title": "Data"
        }
      },
      "required": [
        "schema_version",
        "data"
      ],
      "title": "DecisionResponse",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "title": "Document Version",
          "type": "string"
        },
        "source_kind": {
          "const": "synthetic",
          "default": "synthetic",
          "title": "Source Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "license_ref": {
          "title": "License Ref",
          "type": "string"
        },
        "license_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "License Digest",
          "type": "string"
        },
        "approved_by": {
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "approved": {
          "default": true,
          "title": "Approved",
          "type": "boolean"
        },
        "revoked": {
          "default": false,
          "title": "Revoked",
          "type": "boolean"
        },
        "body": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "document_id",
        "document_version",
        "title",
        "source_ref",
        "license_ref",
        "license_digest",
        "approved_by",
        "approved_at",
        "valid_from",
        "expires_at",
        "body",
        "content_sha256"
      ],
      "title": "Document",
      "type": "object"
    },
    "Embedding": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "$ref": "#/$defs/SopCitation"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "vector": {
          "items": {
            "type": "number"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Vector",
          "type": "array"
        },
        "vector_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Vector Sha256",
          "type": "string"
        },
        "evidence_mode": {
          "const": "synthetic_vector",
          "default": "synthetic_vector",
          "title": "Evidence Mode",
          "type": "string"
        }
      },
      "required": [
        "citation",
        "profile",
        "vector",
        "vector_sha256"
      ],
      "title": "Embedding",
      "type": "object"
    },
    "PendingCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/CopyCandidate"
        },
        "state": {
          "const": "awaiting_review",
          "title": "State",
          "type": "string"
        },
        "source_current": {
          "const": true,
          "title": "Source Current",
          "type": "boolean"
        },
        "draft_id": {
          "const": null,
          "title": "Draft Id",
          "type": "null"
        },
        "publication_allowed": {
          "const": false,
          "title": "Publication Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "candidate",
        "state",
        "source_current",
        "draft_id",
        "publication_allowed"
      ],
      "title": "PendingCandidate",
      "type": "object"
    },
    "PgEvidence": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "$ref": "#/$defs/Embedding"
        },
        "profile": {
          "$ref": "#/$defs/PgProfile"
        },
        "stored_hex": {
          "pattern": "^[0-9a-f]+$",
          "title": "Stored Hex",
          "type": "string"
        },
        "stored_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Stored Sha256",
          "type": "string"
        },
        "distance": {
          "maximum": 2,
          "minimum": 0,
          "title": "Distance",
          "type": "number"
        },
        "query": {
          "$ref": "#/$defs/Query"
        },
        "reference_distance": {
          "maximum": 2,
          "minimum": 0,
          "title": "Reference Distance",
          "type": "number"
        }
      },
      "required": [
        "origin",
        "profile",
        "stored_hex",
        "stored_sha256",
        "distance",
        "query",
        "reference_distance"
      ],
      "title": "PgEvidence",
      "type": "object"
    },
    "PgProfile": {
      "additionalProperties": false,
      "properties": {
        "origin_profile_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Origin Profile Digest",
          "type": "string"
        },
        "dimension": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Dimension",
          "type": "integer"
        },
        "encoding_version": {
          "const": "knowledge-vector-pg-f32-v1",
          "default": "knowledge-vector-pg-f32-v1",
          "title": "Encoding Version",
          "type": "string"
        },
        "numeric_policy": {
          "const": "bounded-components-1e-6-1e6-normsq-1e-12-1e12-v1",
          "default": "bounded-components-1e-6-1e6-normsq-1e-12-1e12-v1",
          "title": "Numeric Policy",
          "type": "string"
        },
        "distance_version": {
          "const": "cosine-pgvector-0.8.7-f32-v1",
          "default": "cosine-pgvector-0.8.7-f32-v1",
          "title": "Distance Version",
          "type": "string"
        },
        "profile_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Profile Digest",
          "type": "string"
        }
      },
      "required": [
        "origin_profile_digest",
        "dimension",
        "profile_digest"
      ],
      "title": "PgProfile",
      "type": "object"
    },
    "PgRetrieval": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "p6-pg-retrieval-v1",
          "default": "p6-pg-retrieval-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "registry_id": {
          "format": "uuid",
          "title": "Registry Id",
          "type": "string"
        },
        "registry_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Registry Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "registry_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Registry Digest",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/PgProfile"
        },
        "query": {
          "$ref": "#/$defs/Query"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "evidence_mode": {
          "const": "synthetic_vector",
          "default": "synthetic_vector",
          "title": "Evidence Mode",
          "type": "string"
        },
        "complete": {
          "const": true,
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "exhaustive": {
          "const": true,
          "default": true,
          "title": "Exhaustive",
          "type": "boolean"
        },
        "eligible_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Eligible Count",
          "type": "integer"
        },
        "pool": {
          "items": {
            "$ref": "#/$defs/PgEvidence"
          },
          "maxItems": 20,
          "title": "Pool",
          "type": "array"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/SopCitation"
          },
          "maxItems": 5,
          "title": "Hits",
          "type": "array"
        },
        "max_distance": {
          "maximum": 2,
          "minimum": 0,
          "title": "Max Distance",
          "type": "number"
        },
        "reason": {
          "enum": [
            "OK",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Reason",
          "type": "string"
        },
        "result_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Hash",
          "type": "string"
        }
      },
      "required": [
        "registry_id",
        "registry_version",
        "scope",
        "registry_digest",
        "profile",
        "query",
        "as_of",
        "eligible_count",
        "pool",
        "hits",
        "max_distance",
        "reason",
        "result_hash"
      ],
      "title": "PgRetrieval",
      "type": "object"
    },
    "ProductCitation": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "const": "product",
          "default": "product",
          "title": "Source Kind",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/ProductFacts"
        },
        "field_path": {
          "const": "title",
          "default": "title",
          "title": "Field Path",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot",
        "text",
        "evidence_id"
      ],
      "title": "ProductCitation",
      "type": "object"
    },
    "ProductFacts": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_kind": {
          "const": "synthetic",
          "default": "synthetic",
          "title": "Source Kind",
          "type": "string"
        },
        "source_binding_id": {
          "title": "Source Binding Id",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "revoked": {
          "default": false,
          "title": "Revoked",
          "type": "boolean"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "facts_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Facts Hash",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "snapshot_id",
        "source_binding_id",
        "source_version",
        "source_digest",
        "sku",
        "captured_at",
        "expires_at",
        "title",
        "facts_hash"
      ],
      "title": "ProductFacts",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "title": "Profile Version",
          "type": "string"
        },
        "provider": {
          "const": "synthetic",
          "default": "synthetic",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "const": "hand-authored-vector",
          "default": "hand-authored-vector",
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "dimension": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Dimension",
          "type": "integer"
        },
        "preprocessing_version": {
          "const": "unchanged-codepoints-v1",
          "default": "unchanged-codepoints-v1",
          "title": "Preprocessing Version",
          "type": "string"
        },
        "distance_version": {
          "const": "cosine-f64-v1",
          "default": "cosine-f64-v1",
          "title": "Distance Version",
          "type": "string"
        },
        "profile_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Profile Digest",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "model_version",
        "dimension",
        "profile_digest"
      ],
      "title": "Profile",
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "query_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "vector": {
          "items": {
            "type": "number"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Vector",
          "type": "array"
        },
        "vector_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Vector Sha256",
          "type": "string"
        },
        "evidence_mode": {
          "const": "synthetic_vector",
          "default": "synthetic_vector",
          "title": "Evidence Mode",
          "type": "string"
        }
      },
      "required": [
        "text",
        "query_hash",
        "profile",
        "vector",
        "vector_sha256"
