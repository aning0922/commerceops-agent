{
  "name": "commerceops-console",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "description": "Phase3 frozen M1 console; B01 explicit offline Mock mode",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:toolchain": "node tooling/check-toolchain.ts",
    "test:web": "playwright test",
    "test:web:install": "playwright install chromium",
    "test:contract": "playwright test --config playwright.contract.config.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "check:read-schema": "node tooling/sync-p3-read-schema.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource/source-sans-pro": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
