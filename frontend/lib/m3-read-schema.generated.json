    "DailyFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Finding Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "SOURCE_INCOMPLETE",
            "ORDER_AMOUNT_MISMATCH",
            "AGGREGATE_OUT_OF_RANGE",
            "PAYMENT_TIMESTAMP_MISSING",
            "NO_RECORDED_PAYMENTS",
            "LOW_PAID_TOTAL",
            "HIGH_REFUND_AMOUNT",
            "RULE_NOT_CONFIGURED"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        },
        "metric_key": {
          "anyOf": [
            {
              "enum": [
                "created_order_count",
                "paid_order_count",
                "paid_product_net",
                "paid_product_tax",
                "paid_shipping_net",
                "paid_shipping_tax",
                "paid_fee_net",
                "paid_fee_tax",
                "paid_order_total",
                "refund_count",
                "refunded_order_count",
                "refund_amount",
                "average_paid_order_value",
                "orders_without_payment_timestamp"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metric Key"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "rule_version": {
          "const": "daily-rules-v1",
          "default": "daily-rules-v1",
          "title": "Rule Version",
          "type": "string"
        },
        "rule_config_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rule Config Hash",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "code",
        "severity",
        "metric_key",
        "evidence_ids",
        "rule_config_hash"
      ],
      "title": "DailyFinding",
      "type": "object"
    },
    "ExactAverage": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "title": "Numerator",
          "type": "string"
        },
        "denominator": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Denominator",
          "type": "string"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "ExactAverage",
      "type": "object"
    },
