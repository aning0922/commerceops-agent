{
  "$defs": {
    "AttentionDaily": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "p6-m3-web-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "shop_id": {
          "format": "uuid",
          "title": "Shop Id",
          "type": "string"
        },
        "kind": {
          "const": "daily_report",
          "title": "Kind",
          "type": "string"
        },
        "workflow_version": {
          "const": "p6-daily-report-v1",
          "title": "Workflow Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "question_creation_enabled": {
          "const": false,
          "title": "Question Creation Enabled",
          "type": "boolean"
        },
        "question_kinds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "const": "metric_definition",
              "type": "string"
            },
            {
              "const": "metric_evidence",
              "type": "string"
            },
            {
              "const": "finding_reason",
              "type": "string"
            },
            {
              "const": "data_quality",
              "type": "string"
            }
          ],
          "title": "Question Kinds",
          "type": "array"
        },
        "schedule_enabled": {
          "const": false,
          "title": "Schedule Enabled",
          "type": "boolean"
        },
        "delivery_enabled": {
          "const": false,
          "title": "Delivery Enabled",
          "type": "boolean"
        },
        "state": {
          "const": "needs_attention",
          "title": "State",
          "type": "string"
        },
        "failure_code": {
          "enum": [
            "DAILY_SOURCE_INCOMPLETE",
            "DAILY_SOURCE_UNAVAILABLE",
            "DAILY_PERMISSION_INVALID",
            "DAILY_SOURCE_BINDING_CHANGED",
            "DAILY_STORAGE_FAILURE",
            "DAILY_WORKFLOW_UNSAFE"
          ],
          "title": "Failure Code",
          "type": "string"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncompleteReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "shop_id",
        "kind",
        "workflow_version",
        "created_at",
        "updated_at",
        "question_creation_enabled",
        "question_kinds",
        "schedule_enabled",
        "delivery_enabled",
        "state",
        "failure_code",
        "report"
      ],
      "title": "AttentionDaily",
      "type": "object"
    },
    "CompleteReport": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "facts_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Facts Hash",
          "type": "string"
        },
        "business_day": {
          "format": "date",
          "title": "Business Day",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/ReadWindow"
        },
        "source": {
          "$ref": "#/$defs/PublicSource"
        },
        "collection_started_at": {
          "format": "date-time",
          "title": "Collection Started At",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "quality_flags": {
          "items": {
            "enum": [
              "MISSING_PAGE",
              "DUPLICATE_ID",
              "SOURCE_CHANGED",
              "CAPACITY_LIMIT",
              "PARTIAL_FAILURE",
              "COVERAGE_UNPROVEN",
              "PAYMENT_STATUS_CONFLICT"
            ],
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/DailyFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "complete": {
          "const": true,
          "title": "Complete",
          "type": "boolean"
        },
        "metrics": {
          "$ref": "#/$defs/ReadMetrics"
        },
        "display": {
          "items": {
            "$ref": "#/$defs/MetricDisplay"
          },
          "title": "Display",
          "type": "array"
        }
      },
      "required": [
        "report_id",
        "snapshot_id",
        "content_hash",
        "facts_hash",
        "business_day",
        "window",
        "source",
        "collection_started_at",
        "collected_at",
        "quality_flags",
        "findings",
        "evidence_count",
        "complete",
        "metrics",
        "display"
      ],
      "title": "CompleteReport",
      "type": "object"
    },
