    "ReadMetrics": {
      "additionalProperties": false,
      "properties": {
        "created_order_count": {
          "minimum": 0,
          "title": "Created Order Count",
          "type": "integer"
        },
        "paid_order_count": {
          "minimum": 0,
          "title": "Paid Order Count",
          "type": "integer"
        },
        "paid_product_net": {
          "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{0,5}[1-9])?$",
          "title": "Paid Product Net",
          "type": "string"
        },
        "paid_product_tax": {
          "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{0,5}[1-9])?$",
          "title": "Paid Product Tax",
          "type": "string"
        },
        "paid_shipping_net": {
          "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{0,5}[1-9])?$",
          "title": "Paid Shipping Net",
          "type": "string"
        },
        "paid_shipping_tax": {
          "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{0,5}[1-9])?$",
          "title": "Paid Shipping Tax",
          "type": "string"
        },
        "paid_fee_net": {
          "pattern": "^(0|-?[1-9][0-9]{0,13}|-?(0|[1-9][0-9]{0,13})\\.[0-9]{0,5}[1-9])$",
          "title": "Paid Fee Net",
          "type": "string"
        },
        "paid_fee_tax": {
          "pattern": "^(0|-?[1-9][0-9]{0,13}|-?(0|[1-9][0-9]{0,13})\\.[0-9]{0,5}[1-9])$",
          "title": "Paid Fee Tax",
          "type": "string"
        },
        "paid_order_total": {
          "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{0,5}[1-9])?$",
          "title": "Paid Order Total",
          "type": "string"
        },
        "refund_count": {
          "minimum": 0,
          "title": "Refund Count",
          "type": "integer"
        },
        "refunded_order_count": {
          "minimum": 0,
          "title": "Refunded Order Count",
